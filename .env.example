# Скопируйте этот файл в .env и укажите API-ключ. Файл .env в git не попадает.
# Без ключа агент работает в режиме «только правила» (флаг --offline делает это явно).

# --- Провайдер LLM: gemini (по умолчанию) | openai (любой OpenAI-совместимый API) | none
LLM_PROVIDER=gemini

# --- Google Gemini (бесплатный ключ: https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
# Запасные модели, если основная перегружена (503) или снята с поддержки:
# Несколько бесплатных ключей (с разных Google-аккаунтов): когда у одного кончится дневная квота, агент возьмёт следующий
# GEMINI_API_KEYS=второй_ключ,третий_ключ
# GEMINI_FALLBACK_MODELS=gemini-flash-latest,gemini-flash-lite-latest

# --- OpenAI-совместимый сервер (OpenAI, OpenRouter, Groq, локальный Ollama/LM Studio)
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# --- Тонкая настройка (можно не трогать)
# LLM_BATCH_SIZE=12        # сколько требований проверять за один запрос
# LLM_MAX_CALLS=60         # максимум запросов к LLM за один прогон
# LLM_MIN_INTERVAL=4       # пауза между запросами, сек (лимиты бесплатного тарифа)
# LLM_TIMEOUT=120
# LLM_MAX_RETRIES=4
# LLM_TEMPERATURE=0.1
