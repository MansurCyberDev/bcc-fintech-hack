# Скопируйте этот файл в .env и укажите API-ключ выбранного провайдера LLM.
# Никогда не коммитьте .env с реальными ключами!

# Google Gemini API (бесплатный ключ: https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=

# Другие провайдеры (по выбору команды):
# OPENAI_API_KEY=
# OPENAI_MODEL=
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=
